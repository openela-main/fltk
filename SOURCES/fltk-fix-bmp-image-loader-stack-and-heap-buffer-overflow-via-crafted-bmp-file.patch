From 3a049d8262dc759cf9737339420e8457e24c0cb1 Mon Sep 17 00:00:00 2001
From: ManoloFLTK <41016272+ManoloFLTK@users.noreply.github.com>
Date: Thu, 22 Oct 2026 16:17:50 +0200
Subject: [PATCH] Fix "BMP Image Loader: Stack and Heap Buffer Overflow via
 Crafted BMP File" (#1632)

Many thanks to @Haind03 for detecting the issue and sharing a fix.

Downstream adaptation note (RHEL, fltk 1.3.8):
Upstream fixed load_bmp_() in the refactored 1.4.x reader
(Fl_Image_Reader, width/height/dstBDepth). fltk 1.3.8 implements the
loader in the Fl_BMP_Image constructor using FILE*/fread and
w()/h()/d(), so the fix was applied by hand there: the new
colors_used > 256 check uses the file's existing error path
(fclose(fp); w(0); h(0); d(0); ld(ERR_FORMAT);) and the image
buffer size is computed as (size_t)w() * h() * d().
---
 src/Fl_BMP_Image.cxx | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/Fl_BMP_Image.cxx b/src/Fl_BMP_Image.cxx
index bcbac4eb..25a9c356 100644
--- a/src/Fl_BMP_Image.cxx
+++ b/src/Fl_BMP_Image.cxx
@@ -179,6 +179,11 @@ Fl_BMP_Image::Fl_BMP_Image(const char *bmp) // I - File to read
   if (colors_used == 0 && depth <= 8)
     colors_used = 1 << depth;
 
+  if (colors_used > 256) {
+    fclose(fp);
+    w(0); h(0); d(0); ld(ERR_FORMAT);
+    return;
+  }
   for (repcount = 0; repcount < colors_used; repcount ++) {
     // Read BGR color...
     if (fread(colormap[repcount], 1, 3, fp)==0) { /* ignore */ }
@@ -205,7 +210,7 @@ Fl_BMP_Image::Fl_BMP_Image(const char *bmp) // I - File to read
     w(0); h(0); d(0); ld(ERR_FORMAT);
     return;
   }
-  array = new uchar[w() * h() * d()];
+  array = new uchar[(size_t)w() * h() * d()];
   alloc_array = 1;
 
   // Read the image data...
-- 
